# Copy to .env (gitignored) and fill in real creds. No quotes - docker env_file
# takes values literally.
ILO_IP=192.0.2.245
ILO_USER=Administrator
ILO_PASS=changeme
IDRAC_IP=192.0.2.81
IDRAC_USER=root
IDRAC_PASS=changeme

# --- platform auth ---
SESSION_SECRET=generate_with_openssl_rand_hex_32
PLATFORM_USER=admin
PLATFORM_PASS=changeme
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_ALLOWED_USERS=your-github-login
# OpenID Connect (any IdP: Authentik, Keycloak, Entra ID, Google, ...). Enabled when OIDC_ISSUER is set.
# Register a confidential client with redirect URI exactly OIDC_REDIRECT_URI. Fail-closed: only users
# (preferred_username or email) or groups (`groups` claim) listed below get in.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=https://bastion.example.com/auth/oidc/callback
OIDC_ALLOWED_USERS=
OIDC_ALLOWED_GROUPS=
# Button text: "Sign in with <OIDC_LABEL>" (default "single sign-on")
OIDC_LABEL=

# Fan max RPM for the % <-> RPM dashboard toggle (best-guess defaults; tune to taste)
FAN_MAX_ILO=18000
FAN_MAX_IDRAC=12000

# --- reverse proxy / TLS ---
# Set TRUST_PROXY=1 ONLY when the app is reached solely through a TLS proxy
# (Nginx Proxy Manager, etc.) that sets X-Forwarded-Proto. It makes OAuth
# redirects use https and marks the session cookie Secure.
TRUST_PROXY=0
# Host interface the container's 8088 binds to. Default 127.0.0.1 keeps it off
# the LAN (proxy fronts it). Set 0.0.0.0 to reach :8088 directly - not advised.
WEB_BIND=127.0.0.1
